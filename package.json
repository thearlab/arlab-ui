{
  "name": "@arlab/ui",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "ARLAB's design system: tokens, components, layouts and patterns for every internal tool and dashboard.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./stories": { "types": "./dist/stories/index.d.ts", "default": "./dist/stories/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "favicon.svg"],
  "scripts": {
    "build": "node scripts/build-css.mjs && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:css": "node scripts/build-css.mjs",
    "check:contrast": "node scripts/contrast.mjs",
    "test": "npm --prefix tools run test",
    "test:visual": "npm --prefix tools run visual",
    "harness": "npm --prefix tools run harness",
    "check": "npm run check:contrast && npm run build && npm test && npm run test:visual"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3"
  }
}
