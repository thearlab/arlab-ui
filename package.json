{
  "name": "@arlab/ui",
  "version": "2.0.0-beta.25",
  "private": true,
  "type": "module",
  "description": "Shared design tokens and UI primitives for ARLAB's internal tools (Agents Studio, ARLAB Knowledge, and future apps).",
  "license": "MIT",
  "main": "./dist/contour/index.js",
  "types": "./dist/contour/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/contour/index.d.ts",
      "import": "./dist/contour/index.js"
    },
    "./styles.css": "./dist/contour/styles.css",
    "./primitives": "./dist/contour/ui.js",
    "./icons": "./dist/contour/icons.js",
    "./loading": "./dist/contour/loading.js",
    "./scroll-area": "./dist/contour/scroll-area.js",
    "./tokens": "./dist/contour/system.js",
    "./legacy": "./dist/index.js",
    "./legacy/styles.css": "./dist/styles.css",
    "./package.json": "./package.json",
    "./navigation": {
      "types": "./dist/contour/navigation.d.ts",
      "import": "./dist/contour/navigation.js"
    },
    "./navigation/styles.css": "./dist/contour/navigation.css",
    "./scroll-area/styles.css": "./dist/contour/scroll-area.css"
  },
  "files": [
    "dist",
    "docs",
    "MIGRATION-V2.md"
  ],
  "scripts": {
    "check:css": "node scripts/check-css.mjs",
    "build": "npm run check:css && npm run check:types:public && tsc && cat src/styles.css src/layout.css src/shells.css > dist/styles.css && npm run check:tour && node scripts/build-contour.mjs && npm run check:contour",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "check:tour": "node scripts/check-tour.mjs",
    "check:contour": "node scripts/check-contour.mjs",
    "check:types:public": "node scripts/check-public-types.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3",
    "postcss": "^8.5.6"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  }
}
